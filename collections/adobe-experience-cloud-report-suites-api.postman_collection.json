  "info": {
    "_postman_id": "d2426914-418b-46aa-bfe5-e9b2657564a6",
    "name": "Adobe Experience Cloud Adobe Analytics 2.0 Activities Report Suites API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Adobe Analytics 2.0 API provides programmatic access to Adobe Analytics reporting, management, and configuration capabilities. It enables developers to retrieve report data, manage report suites, configure calculated metrics, segments, and dimensions, and administer users and permissions within Adobe Analytics. The API uses OAuth 2.0 authentication via Adobe I/O and returns JSON responses.\n\nContact Support:\n Name: Adobe Developer",
      "type": "text/plain"
    }
  }
