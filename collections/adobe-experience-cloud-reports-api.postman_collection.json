          "id": "cdbe881b-6f8b-4d3a-8156-5c3f44ce95ca",
          "name": "Adobe Analytics Adobe Experience Cloud Retrieve a Report",
          "request": {
            "name": "Adobe Analytics Adobe Experience Cloud Retrieve a Report",
            "description": {
              "content": "Submits a report request to Adobe Analytics and returns the resulting data. The request body defines the report suite, dimensions, metrics, date range, and any segment or filter criteria. Results are returned as a ranked or trended data set in JSON format.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                ":companyId",
                "reports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "companyId",
                  "description": "(Required) The global company ID for the Analytics account."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rsid\": \"<string>\",\n  \"globalFilters\": [\n    {\n      \"type\": \"<string>\",\n      \"dateRange\": \"<string>\"\n    },\n    {\n      \"type\": \"<string>\",\n      \"dateRange\": \"<string>\"\n    }\n  ],\n  \"metricContainer\": {\n    \"metrics\": [\n      {\n        \"id\": \"<string>\"\n      },\n      {\n        \"id\": \"<string>\"\n      }\n    ]\n  },\n  \"dimension\": \"<string>\",\n  \"settings\": {\n    \"limit\": \"<integer>\",\n    \"page\": \"<integer>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
