          "name": "Adobe Analytics Adobe Experience Cloud List Dimensions",
          "request": {
            "name": "Adobe Analytics Adobe Experience Cloud List Dimensions",
            "description": {
              "content": "Returns all available dimensions for a specified report suite. Each dimension includes its ID, name, description, data type, and segmentable status.",
              "type": "text/plain"
            },
